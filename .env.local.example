# --- Supabase (shared with the main app) ---
# Same Supabase project as the app: the waitlist API inserts into the shared
# `waitlist` table that the app admin panel reads for onboarding.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Resend (transactional email: waitlist + team invites, NOT the contact form) ---
# The contact form goes straight to Web3Forms client-side (see ContactForm.tsx) —
# its access key and delivery inbox live in that file, not here.
RESEND_API_KEY=
EMAIL_FROM=Clienter <noreply@clienter.co.in>
